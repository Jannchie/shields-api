# shields-api configuration
#
# Copy to `.env` and adjust. The binary does NOT read `.env` by itself — it only
# reads the process environment. See "Deployment" below for how to wire this
# file into the systemd unit.
#
# Everything not listed here is a compile-time constant on purpose: request
# timeouts, cache defaults, upstream base URLs, and the SSRF guards are not
# meant to vary per deployment.

# Port to listen on. The bind address is hardcoded to 0.0.0.0.
PORT=1581

# Public base URL advertised in the OpenAPI document, so "Try it" in /docs hits
# the real host instead of localhost. Falls back to http://localhost:$PORT.
BASE_URL=https://shields.jannchie.com

# tracing-subscriber filter. Falls back to "shields_api=info,info".
# Use shields_api=debug to see upstream request/response logging.
RUST_LOG=shields_api=info,info

# GitHub API token for /github/* endpoints. Without it GitHub allows only
# 60 requests/hour per IP; a classic token with no scopes raises this to 5000.
# GITHUB_TOKEN=

# Codeberg API token for /codeberg/* endpoints. Optional — Codeberg's anonymous
# limits are usually enough.
# CODEBERG_TOKEN=

# ---------------------------------------------------------------------------
# Deployment (this host)
# ---------------------------------------------------------------------------
#
# systemd unit /etc/systemd/system/shields-api.service currently inlines the
# variables with `Environment=`. To source this file instead:
#
#   [Service]
#   EnvironmentFile=/root/shields-api/.env
#
# then drop the inline `Environment=` lines and run:
#
#   systemctl daemon-reload && systemctl restart shields-api
#
# Note: EnvironmentFile is parsed by systemd, not a shell — no `export`, no
# variable expansion, no inline comments after a value.
